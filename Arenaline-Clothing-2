/* General Styles */
body {
  font-family: Arial, sans-serif;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 2rem;
}

h1, h2 {
  text-align: center;
  margin: 1rem 0;
}

a {
  text-decoration: none;
  color: inherit;
}

/* Header */
.header {
  background-color: #333;
  color: #fff;
  position: sticky;
  top: 0;
  z-index: 1000;
}

.logo {
  font-size: 1.5rem;
  font-weight: bold;
}

.nav-links {
  display: flex;
  list-style: none;
}

.nav-links li {
  margin: 0 1rem;
}

.nav-links a {
  color: #fff;
  padding: 0.5rem 1rem;
  transition: background 0.3s ease;
}

.nav-links a:hover {
  background: #555;
  border-radius: 4px;
}

/* Hero Section */
.hero {
  background: url('hero-bg.jpg') no-repeat center center/cover;
  color: #fff;
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.hero .btn {
  background: #ff6347;
  color: #fff;
  padding: 0.8rem 1.5rem;
  border: none;
  border-radius: 4px;
  cursor: pointer;
}

.hero .btn:hover {
  background: #e5533f;
}

/* Featured Products */
.featured {
  padding: 2rem;
  background: #f9f9f9;
}

.product-grid {
  display: flex;
  gap: 2rem;
  justify-content: center;
}

.product {
  background: #fff;
  padding: 1rem;
  text-align: center;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}

.product img {
  max-width: 100%;
  height: auto;
  margin-bottom: 1rem;
}

/* Contact Section */
.contact {
  padding: 2rem;
  text-align: center;
  background: #333;
  color: #fff;
}

.contact form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  max-width: 400px;
  margin: 0 auto;
}

.contact input, .contact textarea, .contact button {
  padding: 0.8rem;
  border: none;
  border-radius: 4px;
}

.contact button {
  background: #ff6347;
  color: #fff;
  cursor: pointer;
}

.contact button:hover {
  background: #e5533f;
}

/* Footer */
.footer {
  text-align: center;
  padding: 1rem;
  background: #222;
  color: #fff;
